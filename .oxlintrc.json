{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    // `Array#toSorted` is ES2023, the repo targets ES2022.
    "unicorn/no-array-sort": "off"
  }
}
