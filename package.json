{
  "name": "@uncheck/repo",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "simple-git-hooks && pnpm -r run build --stub",
    "check": "uncheck",
    "check:fix": "uncheck --fix",
    "test": "pnpm run -r test && vitest run",
    "test:coverage": "pnpm run -r test && vitest run --coverage",
    "bench": "vitest bench --run",
    "repo:fix": "sherif --fix",
    "sponsors:sync": "node scripts/sync-sponsors.ts && pnpm check:fix '**/README.md'"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.7.1",
    "@types/node": "^26.6.2",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "bumpp": "^12.3.0",
    "changelogithub": "^15.0.5",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "pkg-pr-new": "^0.0.88",
    "sherif": "^1.13.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "unbuild": "^3.6.1",
    "uncheck": "workspace:*",
    "vitest": "^5.0.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "uncheck --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  }
}
