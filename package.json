{
  "name": "@uncheck/repo",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "pnpm run check prepare --pre-commit",
    "check": "pnpm exec --filter=./packages/uncheck obuild --stub && uncheck",
    "fix": "pnpm run check --fix",
    "test": "pnpm run -r test && vitest run",
    "test:coverage": "pnpm run -r test && vitest run --coverage",
    "bench": "vitest bench --run",
    "sponsors:sync": "node scripts/sync-sponsors.ts && pnpm run fix '**/README.md'"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.7.1",
    "@types/node": "^26.6.4",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "bumpp": "^12.3.0",
    "changelogithub": "^15.0.5",
    "obuild": "^0.4.43",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "pkg-pr-new": "^0.0.88",
    "sherif": "^1.13.0",
    "typescript": "^7.0.2",
    "uncheck": "workspace:*",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.20"
  }
}
