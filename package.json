{
  "name": "@uncheck/repo",
  "version": "0.0.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "pnpm run check prepare --pre-commit",
    "check": "pnpm exec --filter=./packages/uncheck unbuild --stub && uncheck",
    "fix": "pnpm run check --fix",
    "test": "pnpm run -r test && vitest run",
    "test:coverage": "pnpm run -r test && c8 --all --include='packages/*/src/**' --exclude='packages/*/src/types.ts' --reporter=text --reporter=lcov --check-coverage --100 vitest run",
    "bench": "vitest bench --run",
    "sponsors:sync": "node scripts/sync-sponsors.ts && pnpm run fix '**/README.md'"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.7.1",
    "@types/node": "^26.6.2",
    "@typescript/typescript6": "^6.0.2",
    "bumpp": "^12.3.0",
    "c8": "^12.0.0",
    "changelogithub": "^15.0.5",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "pkg-pr-new": "^0.0.88",
    "sherif": "^1.13.0",
    "typescript": "^7.0.2",
    "unbuild": "^3.6.1",
    "uncheck": "workspace:*",
    "vitest": "^5.0.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.20"
  }
}
