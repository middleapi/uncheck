{
  "name": "@uncheck/repo",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "type:check": "pnpm -r run type:check && tsc",
    "test": "pnpm run -r test && vitest run",
    "test:coverage": "pnpm run -r test && vitest run --coverage",
    "bench": "vitest bench --run",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "repo:fix": "sherif --fix",
    "sponsors:sync": "node scripts/sync-sponsors.ts && eslint --fix **/README.md"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@codspeed/vitest-plugin": "^5.7.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "bumpp": "^12.3.0",
    "changelogithub": "^15.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-format": "^2.0.1",
    "lint-staged": "^17.5.1",
    "pkg-pr-new": "^0.0.88",
    "sherif": "^1.13.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^5.0.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --no-warn-ignored --fix"
  }
}
