{
  "name": "uncheck",
  "version": "0.0.1",
  "description": "One command to lint, format check and typecheck a project with oxlint, oxfmt and tsc",
  "keywords": [
    "oxc",
    "oxfmt",
    "oxlint",
    "tsc",
    "typecheck",
    "uncheck",
    "unified check command"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/uncheck.git",
    "directory": "packages/uncheck"
  },
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "bin": {
    "uncheck": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "unbuild"
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.0-rc.116",
    "effect": "^4.0.0-rc.116",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "oxfmt": "*",
    "oxlint": "*",
    "typescript": "*"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
