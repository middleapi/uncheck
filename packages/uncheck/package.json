{
  "name": "uncheck",
  "version": "0.1.1",
  "description": "One command to lint, format check, typecheck and check monorepo consistency with oxlint, oxfmt, tsc and sherif",
  "keywords": [
    "git hooks",
    "lint-staged",
    "monorepo",
    "oxc",
    "oxfmt",
    "oxlint",
    "pre-commit",
    "sherif",
    "tsc",
    "typecheck",
    "uncheck",
    "unified check command"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/uncheck.git",
    "directory": "packages/uncheck"
  },
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "bin": {
    "uncheck": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "tsconfig"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./oxfmt": {
      "types": "./dist/presets/oxfmt.d.mts",
      "default": "./dist/presets/oxfmt.mjs"
    },
    "./oxlint": {
      "types": "./dist/presets/oxlint.d.mts",
      "default": "./dist/presets/oxlint.mjs"
    },
    "./tsconfig/middleapi": "./tsconfig/middleapi/base.json",
    "./tsconfig/middleapi/lib": "./tsconfig/middleapi/lib.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "obuild"
  },
  "devDependencies": {
    "@effect/platform-node": "^4.0.0",
    "effect": "^4.0.0",
    "jsonc-parser": "^3.3.1",
    "minimatch": "^10.2.6",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "sherif": "^1.13.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "oxfmt": "*",
    "oxlint": ">=1.60.0",
    "sherif": ">=1.10.0",
    "typescript": "*"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "sherif": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.20"
  }
}
